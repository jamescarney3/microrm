{
  "name": "@jamescarney3/microrm",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/microrm.js",
  "module": "./dist/microrm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/microrm.js",
      "require": "./dist/microrm.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:watch": "tsc -b --noEmit && vite build --watch",
    "compile:watch": "tsc -b --noEmit --watch",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:verbose": "vitest --reporter=verbose",
    "test:ci": "vitest run --coverage --coverage.reporter=json-summary --watch=false",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "sinon": "^21.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-babel": "^1.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
